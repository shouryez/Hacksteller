# Copy to .env.local and fill in. Never commit .env.local.
# AI for structuring stories, answering questions, interview questions and guide merging.
# Gemini is used when its key is set; otherwise Claude; otherwise the offline brain.
GEMINI_API_KEY=
# Optional: force a Gemini model first (default chain: gemini-2.5-flash → 2.5-flash-lite → flash-latest → 3.8-flash).
GEMINI_MODEL=
ANTHROPIC_API_KEY=
# Sarvam AI (Indian-language speech-to-text, translation and natural voices). Without it the browser's speech APIs are used.
SARVAM_API_KEY=
